# Copy to backend/.env and fill in real values. Never commit .env.
SECRET_KEY=change-me-long-random-string
DEBUG=True
DATABASE_URL=postgres://sawa:sawa@localhost:5434/sawa
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=https://your-domain.com   (required for admin/login over HTTPS)
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO (set on Render/Fly/etc.)
# Optional — login rate limits (defaults shown):
# LOGIN_EMAIL_THROTTLE_RATE=5/min   (max login attempts per account email)
# LOGIN_IP_THROTTLE_RATE=20/min     (max login attempts per client IP)
# Optional — HTTPS hardening (auto-on when DEBUG=False; keep unset locally):
# SECURE_SSL_REDIRECT=True          (301 http → https)
# SECURE_HSTS_SECONDS=2592000       (Strict-Transport-Security max-age)
SEED_DEMO_PASSWORD=change-me
